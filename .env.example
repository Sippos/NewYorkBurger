# Copy this file to .env and fill the values. Do NOT commit your real .env

# The Movie Database API key (client-side safe key)
VITE_TMDB_KEY=your_tmdb_api_key_here

# (Optional) OMDb API key to fetch IMDb ratings
VITE_OMDB_KEY=your_omdb_api_key_here

# Supabase project URL and anon/public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
